import datetime as dt
import logging
from collections.abc import Callable, Sequence
from functools import cache
from typing import Any

from langchain.agents import create_agent
from langchain_core.messages import HumanMessage

from __PACKAGE__.config import get_settings
from __PACKAGE__.state import State

logger = logging.getLogger(__name__)


def format_user_prompt(template: str, state: State) -> str:
    """Fill ``template`` with ``{current_date}`` plus every key in ``state``."""
    return template.format(current_date=dt.date.today().isoformat(), **state)


def make_agent_node(
    *,
    name: str,
    system_prompt: str,
    user_prompt_template: str,
    output_state_key: str,
    tools: Sequence[Any] = (),
    model: str | None = None,
) -> Callable[[State], dict]:
    """Build a LangGraph node that runs a single-turn agent.

    The node formats ``user_prompt_template`` with the state (see
    ``format_user_prompt``), invokes the agent, and writes the final message
    text to ``state[output_state_key]``. When ``state["debug"]`` is set it logs
    the prompt and returns ``""`` without calling the model.

    The agent is built on first real call, so importing the graph or running
    in debug mode never needs API keys.
    """

    @cache
    def get_agent():
        return create_agent(
            name=name,
            system_prompt=system_prompt,
            model=model or get_settings().default_model,
            tools=list(tools) or None,
        )

    def node(state: State) -> dict:
        user_prompt = format_user_prompt(user_prompt_template, state)

        if state.get("debug"):
            logger.info("[%s] user prompt:\n%s", name, user_prompt)
            return {output_state_key: ""}

        response = get_agent().invoke({"messages": [HumanMessage(content=user_prompt)]})
        return {output_state_key: response["messages"][-1].content}

    return node
